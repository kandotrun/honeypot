[Unit]
Description=Relay honeypot status from the tailnet VPS to the office LAN display
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=kan
ExecStart=/usr/bin/python3 /home/kan/honeypot-relay/pi_relay.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
